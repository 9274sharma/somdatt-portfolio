# Copy to .env.local and fill in. On Vercel, add the same keys (Production + Preview). Never commit real values.

# ── Sanity CMS — https://sanity.io ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Editor token: bookings (private documents), reviews, admin actions, draft previews.
SANITY_WRITE_TOKEN=

# ── Admin (/admin) ──
ADMIN_PASSWORD=
# Random secret for the admin session and signed links — e.g. `openssl rand -base64 32`.
AUTH_SECRET=

# ── Emails — https://resend.com (somdattsharma.com verified) ──
RESEND_API_KEY=
# Sender of the owner notifications.
RESEND_FROM=Somdatt Sharma <hello@somdattsharma.com>
# Where new requests/reviews are announced (Somdatt's inbox).
CONTACT_TO_EMAIL=
# Optional — sender of client emails (default: Somdatt Sharma <booking@somdattsharma.com>).
# BOOKING_FROM=
# Optional — links in emails (default: https://www.somdattsharma.com).
# SITE_URL=

# ── Optional: WhatsApp ping for new requests — https://www.callmebot.com/ ──
# Phone in the format CallMeBot shows (digits only, e.g. 491234567890).
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=

# ── Google Calendar (write-only: accepted bookings are added, personal events are never read) ──
# Service account from Google Cloud; share the calendar with GOOGLE_CLIENT_EMAIL ("Make changes to events").
GOOGLE_CLIENT_EMAIL=
# The key from the service-account JSON, in quotes, with \n line breaks.
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# ── Travel time by car — https://openrouteservice.org (free key) ──
ORS_API_KEY=

# ── Studio auto-translation (EN → DE) via Vercel AI Gateway ──
# Auth is automatic on Vercel (OIDC); locally run `vercel env pull`. Optional model override:
# AI_TRANSLATE_MODEL=
