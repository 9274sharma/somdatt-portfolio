# Contact form — copy to .env.local and fill in.

# https://resend.com — API key + verify a sending domain for production.
# With onboarding@resend.dev you can only send to your own Resend account email.
RESEND_API_KEY=
# After verifying somdattsharma.com in Resend, use e.g. Somdatt <hello@somdattsharma.com>
RESEND_FROM=Portfolio contact <onboarding@resend.dev>
CONTACT_TO_EMAIL=

# Optional: WhatsApp alert via https://www.callmebot.com/ — use the phone format CallMeBot shows
# in your activation message (often digits only, e.g. 491234567890, not +49…).
CALLMEBOT_API_KEY=
CALLMEBOT_PHONE=
